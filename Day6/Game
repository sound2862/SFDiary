using System.Net.Http.Headers;

namespace Game
{
    class Menu
    {
        public void start()
        {
            Console.Write("이름을 입력하세요 : ");
            string userName = Console.ReadLine();
            Console.WriteLine($"어서오세요, 탐험가 {userName}님");
            Console.WriteLine("드디어 떠나는 모험의 첫 걸음을 내딛게 되었군요.");
            Console.WriteLine("먼 길을 험난한 여정을 앞두고 있지만,");
            Console.WriteLine("용기와 지혜로 모든 위기를 헤쳐나가길 바랍니다.");
        }
        public void menu()
        {
            int choice;

            do
            {
                Console.WriteLine("----------------------");
                Console.WriteLine("메뉴선택");
                Console.WriteLine("1. 낡은 마을 탐험");
                Console.WriteLine("2. 숲 속 오두막 방문");
                Console.WriteLine("3. 게임 종료");
                Console.WriteLine("----------------------");
                Console.Write("선택 : ");

                choice = int.Parse(Console.ReadLine());

                switch (choice)
                {
                    case 1:  //마을 선택
                        Console.WriteLine("낡은 마을에 들어섭니다..");
                        Thread.Sleep(2000);
                        Console.WriteLine("이곳은 한때 번성했던 곳이지만 지금은 쇠락해버린 모습입니다.");
                        Thread.Sleep(2000);
                        Console.WriteLine("마을 중심에는 고대의 분수대가 있고,");
                        Thread.Sleep(2000);
                        Console.WriteLine("몇몇 상점과 집들이 있습니다. ");
                        Thread.Sleep(2000);
                        Console.WriteLine("주민들은 걱정스러운 표정으로 당신을 쳐다봅니다.");
                        Thread.Sleep(2000);

                        do
                        {
                            Console.WriteLine("----------------------");
                            Console.WriteLine("선택");
                            Console.WriteLine("1. 마을 주민과 대화하기");
                            Console.WriteLine("2. 고대의 분수대 조사하기");
                            Console.WriteLine("3. 폐허가 된 상점 조사하기");
                            Console.WriteLine("4. 마을 떠나기");
                            Console.WriteLine("----------------------");
                            Console.Write("선택 : ");

                            choice = int.Parse(Console.ReadLine());

                            switch (choice)  //마을이후 선택
                            {
                                case 1:
                                    Console.WriteLine("대화 진행");
                                    Thread.Sleep(1000);
                                    break;
                                case 2:
                                    Console.WriteLine("분수대");
                                    Thread.Sleep(1000);
                                    break;
                                case 3:
                                    Console.WriteLine("상점");
                                    Thread.Sleep(1000);
                                    break;
                                case 4:
                                    Console.WriteLine("당신은 마을을 떠나기로 결정합니다. 불안한 마음을 뒤로한 채, 당신은 마을밖으로 발걸음을 돌립니다.");
                                    Thread.Sleep(2000);
                                    break;
                                default:
                                    break;
                            }

                        } while(choice != 4);

                        break;
                    case 2:
                        Console.WriteLine("오두막 선택");
                        break;
                    case 3:
                        Console.WriteLine("게임을 종료합니다");
                        break;
                    default:
                        break;
                }
            } while (choice != 3);
        }
    }

    internal class Program
    {
        static void Main(string[] args)
        {
            Menu menu = new Menu();

            menu.start();
            menu.menu();
        }
    }
}
